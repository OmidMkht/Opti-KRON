clear
new Circuit.Reduced basekv=4.16 phases=3 bus1=150 frequency=60
redirect Models.dss
redirect Source.dss
redirect Transformers.dss
redirect Branches.dss
redirect Shunts.dss
redirect PhysicalShunts.dss
redirect Loads.dss
redirect Injections.dss
set loadmult=1
set controlmode=off
solve mode=snapshot
