#!/bin/sh
# --------------------------------------------------------------------------- #
# Strip machine-generated attribution trailers from commit messages.
#
# Tools append these automatically -- nobody chose to write them -- so this
# strips them and lets the commit through rather than making you retype a
# message you did not author.
#
# The patterns describe the *shape* of a generated trailer rather than naming
# any vendor: a Co-Authored-By line pointing at a no-reply address, or a
# "Generated with [tool](url)" footer. Naming vendors would put those names in
# this file, which is itself published.
#
# Install: git config core.hooksPath .githooks
# --------------------------------------------------------------------------- #

message_file="$1"
pattern='^(Co-[Aa]uthored-[Bb]y:.*<[^>]*noreply@|.*Generated with \[)'

grep -qE "$pattern" "$message_file" || exit 0

grep -vE "$pattern" "$message_file" > "$message_file.stripped"
# Collapse the run of blank lines the trailer left behind.
awk 'NF {blank = 0} !NF {blank++} blank < 2' "$message_file.stripped" > "$message_file"
rm -f "$message_file.stripped"
echo "commit-msg: removed a generated attribution trailer." >&2
exit 0
